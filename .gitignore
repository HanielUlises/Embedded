# Ignore the entire build directory (recommended approach)
build/
Debug/
Release/

# Object files, dependency files, and linker outputs
*.o
*.obj
*.d
*.map

# Executables/Firmware specific to embedded systems
*.elf
*.hex
*.bin
*.srec

# IDE and Editor-specific files
.vscode/
.eclipse/
*.uvproj*
*.ewp
*.mex
*.suo
*.user
*.ncb

# OS generated files
.DS_Store
Thumbs.db

# Temporary and log files
*.log
*.tmp
*.swp

# ESP-IDF
sdkconfig.old
dependencies.lock
managed_components/
.espressif/

# ESP-IDF build artifacts
build/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# STM32CubeIDE / Eclipse metadata (never commit this)
STM32/.metadata/

# Large datasheets / PDFs you don't need in the repo
*.pdf
!STM32/F401_Pulse/**/*.pdf   # optional: keep only project-related ones if you want

# Zip libraries
*.zip
